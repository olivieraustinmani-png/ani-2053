import os
from Jenga import *
from jengaconfig import *
from Jenga.GlobalToolchains import RegisterJengaGlobalToolchains

_dir = "C:/Users/Austin/Desktop/Nkentseu/Applications/Pworkspace"

with project("Appelants"):
    RegisterJengaGlobalToolchains()
    windowedapp()
    language("C++")
    cppdialect("C++20")
    files([_dir + "/Appelants/src/appelants.cpp"])
    nkentseudependson([
        "NKCanvas", "NKEvent", "NKWindow", "NKGlad", "NKLogger",
        "NKMath", "NKTime", "NKStream", "NKFont",
        "NKContainers", "NKMemory", "NKCore", "NKPlatform", "NKThreading",
        "NKGui", "NKImage", "NKFileSystem"
    ], extra_includes=["src"])
    objdir("%{wks.location}/Build/obj/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
    defines(["WIN32_LEAN_AND_MEAN", "_UNICODE", "UNICODE"])
    links([
        "user32", "gdi32", "opengl32", "dwmapi", "shell32",
        "mf", "mfplat", "mfreadwrite", "mfuuid",
        "uuid", "ole32", "dinput8", "dxguid",
        "d3d11", "d3d12", "dxgi", "d3dcompiler",
        "avrt", "winmm", "ws2_32",
    ])
    with filter("config:Debug"):
        defines(["_DEBUG", "DEBUG"])
        symbols(True)
        optimize("Off")
    with filter("config:Release"):
        defines(["NDEBUG"])
        optimize("Speed")
        symbols(False)
